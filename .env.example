# NairaHR — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required: Hugging Face token for LLM inference API access
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# ChromaDB persistence directory (leave as default for most cases)
CHROMA_PERSIST_DIR=./chroma_db

# Escalation confidence threshold (0.0–1.0)
# Queries with RAG confidence below this value are flagged for human review
ESCALATION_THRESHOLD=0.6

# Logging
LOG_LEVEL=INFO
